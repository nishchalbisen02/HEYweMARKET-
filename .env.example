# Careers application → WhatsApp Cloud API hand-off.
# Copy to .env.local (git-ignored) and fill in. Without these, /api/careers
# returns a friendly 503 and the form asks applicants to email instead.

# Permanent access token for a system user / app with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=

# The sending business phone number's ID (Meta → WhatsApp → API setup)
WHATSAPP_PHONE_NUMBER_ID=

# Where applications are delivered — international format, digits only
WHATSAPP_RECIPIENT_NUMBER=919826026029

# Optional — Graph API version, defaults to v21.0
WHATSAPP_API_VERSION=v21.0
